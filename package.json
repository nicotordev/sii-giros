{
  "name": "@nicotordev/sii-giros",
  "version": "0.1.1",
  "description": "Códigos de actividad económica del SII de Chile, consultables y exportables por rubro.",
  "keywords": [
    "sii",
    "chile",
    "giros",
    "actividad-economica",
    "codigos-sii"
  ],
  "homepage": "https://github.com/nicotordev/sii-giros#readme",
  "bugs": {
    "url": "https://github.com/nicotordev/sii-giros/issues"
  },
  "author": {
    "name": "Nicolas Torres",
    "email": "nicotordev@gmail.com",
    "url": "https://github.com/nicotordev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicotordev/sii-giros.git"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./categorias/*": {
      "types": "./src/categorias/*.ts",
      "default": "./src/categorias/*.ts"
    }
  },
  "files": [
    "src",
    "public",
    "README.md"
  ],
  "scripts": {
    "rubros": "bun index.ts",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
